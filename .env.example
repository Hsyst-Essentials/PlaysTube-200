# Copie para .env e preencha antes de subir o servidor.
# NUNCA use estes exemplos como valores reais (o app rejeita segredos fracos/curtos).

# Chave de assinatura dos tokens JWT — obrigatória, mínimo 32 caracteres.
# Gere uma com: openssl rand -hex 32
JWT_SECRET=

# Origens permitidas no CORS (separadas por vírgula). Vazio habilita apenas localhost.
CORS_ORIGINS=http://localhost:4000,http://127.0.0.1:4000